{
  "manifest_version": 3,
  "name": "Simplify++",
  "version": "1.0.0",
  "description": "Batch job application automation — opens N parallel windows from a queue.",
  "permissions": ["windows", "tabs", "storage", "system.display"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
